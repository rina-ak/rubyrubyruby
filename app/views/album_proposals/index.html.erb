<div style="max-width: 800px; margin: 2rem auto; font-family: sans-serif; padding: 0 1rem;">
  <h2>Заявки на добавление альбомов (<%= @proposals.count %>)</h2>
  <p><%= link_to "← Вернуться в каталог", root_path %></p>

  <% if @proposals.any? %>
    <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
      <thead>
        <tr style="background: #f4f4f4; text-align: left; border-bottom: 2px solid #ddd;">
          <th style="padding: 10px;">ID</th>
          <th style="padding: 10px;">Артист</th>
          <th style="padding: 10px;">Альбом</th>
          <th style="padding: 10px;">Статус</th>
          <th style="padding: 10px;">Комментарий</th>
        </tr>
      </thead>
      <tbody>
        <% @proposals.each do |p| %>
          <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 10px;">#<%= p.id %></td>
            <td style="padding: 10px;"><strong><%= p.artist %></strong></td>
            <td style="padding: 10px;"><%= p.title %></td>
            <td style="padding: 10px;"><span style="background: #e2e8f0; padding: 3px 8px; border-radius: 4px; font-size: 12px;">pending</span></td>
            <td style="padding: 10px; color: #555;"><%= p.notes %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="color: #888;">Заявок пока нет.</p>
  <% end %>
</div>