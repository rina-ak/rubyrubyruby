<% content_for :title, "Предложить альбом" %>

<article class="auth-screen">
  <div class="auth-container proposal-solo">
    <div class="auth-form-card">
      <header class="auth-intro">
        <h1>Предложить альбом</h1>
        <p>Не нашли нужный релиз? Напишите нам, и редакция подготовит разбор: звучание, визуальный язык и контекст.</p>
      </header>

      <%= form_with(model: @proposal, class: "auth-form") do |form| %>
        <% if @proposal.errors.any? %>
          <div class="form-errors" role="alert">Заполните исполнителя и название альбома.</div>
        <% end %>

        <div class="auth-fields">
          <div class="auth-input-group">
            <%= form.label :artist, "Исполнитель", class: "field-label-strong" %>
            <%= form.text_field :artist, placeholder: "например, Radiohead или aespa", class: "text-input" %>
          </div>
          <div class="auth-input-group">
            <%= form.label :title, "Название альбома", class: "field-label-strong" %>
            <%= form.text_field :title, placeholder: "например, In Rainbows", class: "text-input" %>
          </div>
          <div class="auth-input-group">
            <%= form.label :notes, "Почему этот альбом важен?", class: "field-label-strong" %>
            <%= form.text_area :notes, rows: 4, placeholder: "Визуал, клипы, скрытые смыслы", class: "text-input" %>
          </div>
        </div>

        <div class="auth-actions">
          <%= form.submit "Отправить заявку", class: "btn-primary" %>
          <p class="auth-switch"><%= link_to "В каталог", albums_path %></p>
        </div>
      <% end %>
    </div>
  </div>
</article>
