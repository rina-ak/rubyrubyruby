<% content_for :title, "Подборки" %>

<article class="home-page">
  <header class="decode-catalog-head home-collections-head">
    <h1 class="decode-catalog-title">Подборки</h1>
    <p class="decode-catalog-count">Альбомы, связанные одним наблюдением</p>
  </header>

  <article class="home-feature-card">
    <%= image_tag @featured[:image], alt: "", class: "home-feature-art" %>
    <div class="home-feature-copy">
      <p class="home-eyebrow"><%= @featured[:eyebrow] %></p>
      <div>
        <h2 class="home-feature-title"><%= @featured[:title] %></h2>
        <p><%= @featured[:summary] %></p>
        <p class="home-count"><%= russian_plural(@featured[:count], "альбом", "альбома", "альбомов") %></p>
      </div>
      <%= link_to "Открыть подборку", collection_path(@featured[:slug]), class: "btn-primary home-open" %>
    </div>
  </article>

  <section class="home-block">
    <h2 class="home-section-title">Все подборки</h2>
    <div class="home-collection-grid">
      <% @collections.each do |item| %>
        <%= link_to collection_path(item[:slug]), class: "home-collection" do %>
          <%= image_tag item[:image], alt: "", class: "home-collection-art" %>
          <p class="home-eyebrow"><%= item[:eyebrow] %></p>
          <h3><%= item[:title] %></h3>
          <p><%= item[:summary] %></p>
          <p class="home-count"><%= russian_plural(item[:count], "альбом", "альбома", "альбомов") %></p>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="home-block">
    <h2 class="home-section-title">Внутри подборок</h2>
    <div class="decode-catalog-grid home-album-grid">
      <% @inside.each do |album| %>
        <%= render "albums/spotlight", album: album %>
      <% end %>
    </div>
  </section>
</article>
