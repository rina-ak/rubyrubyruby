<!DOCTYPE html>
<html>
  <head>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <title><%= content_for(:title) || "Decode" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Decode">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="header">
      <div class="brand">
        <%= link_to "decode", root_path %>
      </div>

      <nav class="nav">
        <%= link_to "Каталог", albums_path %>
        <%= link_to "Подборки", collections_path %>
        <%= link_to "О проекте", about_path %>
        <button type="button" class="btn-text" data-search-open>Поиск</button>

        <% if user_signed_in? %>
          <div class="nav-account">
            <span class="nav-user-email">
              <%= current_user.email %>
            </span>
            <%= button_to "Выйти", destroy_user_session_path, method: :delete, form: { class: "inline-form" }, class: "btn-text" %>
          </div>
        <% else %>
          <div class="nav-account-guest">
            <%= link_to "Войти", new_user_session_path %>
            <%= link_to "Регистрация", new_user_registration_path %>
          </div>
        <% end %>

        <% if can?(:read, AlbumProposal) %>
          <%= link_to "Заявки", album_proposals_path %>
        <% end %>
        <%= link_to "Предложить альбом", new_album_proposal_path, class: "btn-header-cta" %>
      </nav>
    </header>

    <main class="container">
      <% if notice %>
        <p class="flash-notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="flash-alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
    <%= render "albums/search_modal" %>
    <script>
      (function () {
        var modal = document.getElementById("search-modal");
        if (!modal) return;
        var input = modal.querySelector("[data-search-input]");

        function openModal() {
          modal.hidden = false;
          document.body.classList.add("search-open");
          if (input) input.focus();
        }

        function closeModal() {
          modal.hidden = true;
          document.body.classList.remove("search-open");
        }

        document.querySelectorAll("[data-search-open]").forEach(function (button) {
          button.addEventListener("click", openModal);
        });
        modal.querySelectorAll("[data-search-close]").forEach(function (button) {
          button.addEventListener("click", closeModal);
        });
        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") closeModal();
        });
      })();
    </script>
  </body>
</html>
