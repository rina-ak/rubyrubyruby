<!DOCTYPE html>
<html>
  <head>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@700;800;900&display=swap" rel="stylesheet">
    
    <title><%= content_for(:title) || "Decode" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Decode">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="header">
      <div class="brand">
        <%= link_to "decode", root_path %>
      </div>

      <nav class="nav">
        <%= link_to "Каталог", root_path, class: ("active" if current_page?(root_path)) %>
        <%= link_to "Подборки", root_path %>
        <%= link_to "О проекте", root_path %>

        <% if user_signed_in? %>
          <span style="margin-left: 24px; font-size: 14px; color: #777;">
            <%= current_user.email %>
          </span>
          <%= button_to "Выйти", destroy_user_session_path, method: :delete, style: "margin-left: 16px; background: none; border: none; font-size: 15px; color: #666; cursor: pointer; padding: 0; font-family: inherit;", onmouseover: "this.style.color='#000'", onmouseout: "this.style.color='#666'" %>
        <% else %>
          <%= link_to "Войти", new_user_session_path %>
          <%= link_to "Регистрация", new_user_registration_path %>
        <% end %>

        <%= link_to "Предложить альбом", new_album_path, class: "btn-header-cta" rescue nil %>
      </nav>
    </header>

    <main class="container">
      <% if notice %>
        <p style="background: #e6f9ed; color: #1e7e34; padding: 10px 16px; border-radius: 6px; margin-bottom: 20px; font-size: 14px;"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p style="background: #fdf2f2; color: #9b1c1c; padding: 10px 16px; border-radius: 6px; margin-bottom: 20px; font-size: 14px;"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>