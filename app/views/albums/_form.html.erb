<%= form_with(model: album, class: "album-form") do |form| %>
  <% if album.errors.any? %>
    <div class="form-errors-block">
      <h2>Не удалось сохранить альбом (<%= russian_plural(album.errors.count, "ошибка", "ошибки", "ошибок") %>):</h2>
      <ul>
        <% album.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :title, "Название", class: "field-label" %>
    <%= form.text_field :title %>
  </div>

  <div class="form-field">
    <%= form.label :artist, "Исполнитель", class: "field-label" %>
    <%= form.text_field :artist %>
  </div>

  <div class="form-field">
    <%= form.label :year, "Год выпуска", class: "field-label" %>
    <%= form.number_field :year %>
  </div>

  <div class="form-field">
    <%= form.label :duration, "Длительность", class: "field-label" %>
    <%= form.text_field :duration %>
  </div>

  <div class="form-field">
    <%= form.label :release_type, "Тип релиза", class: "field-label" %>
    <%= form.text_field :release_type %>
  </div>

  <div class="form-field">
    <%= form.label :genre, "Жанр", class: "field-label" %>
    <%= form.text_field :genre %>
  </div>

  <div class="form-field">
    <%= form.label :description, "Описание", class: "field-label" %>
    <%= form.text_area :description, rows: 5, class: "text-area-bounded" %>
  </div>

  <div class="form-field">
    <%= form.label :cover, "Обложка альбома", class: "field-label" %>
    <% if album.cover.present? %>
      <div class="current-cover">
        <span class="current-cover-label">Текущая обложка:</span>
        <img src="<%= album.cover.to_s.start_with?('/') ? album.cover.to_s : album.cover.url %>"
             alt="<%= album.title %>"
             class="cover-thumb">
      </div>
    <% end %>
    <%= form.file_field :cover, accept: "image/*" %>
    <small class="form-hint">Оставьте пустым, если не хотите менять обложку</small>
  </div>

  <div class="form-actions">
    <%= form.submit "Сохранить", class: "btn" %>
  </div>
<% end %>
