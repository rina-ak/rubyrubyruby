<div class="album-card" id="<%= dom_id album %>">
  <div class="album-cover">
    <% if album.cover.present? %>
      <%= image_tag album.cover.url, alt: album.title %>
    <% else %>
      <div style="width: 140px; height: 140px; background: #eee; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #888;">
        Нет обложки
      </div>
    <% end %>
  </div>

  <div class="album-info">
    <div class="album-meta">
      • <%= album.genre.presence || "Electronic" %> • <%= album.year %>
    </div>
    <h3 class="album-title"><%= album.title %></h3>
    <div class="album-artist"><%= album.artist %></div>
    
    <% if album.description.present? %>
      <div class="album-intro"><%= album.description %></div>
    <% end %>

    <%= link_to "Перейти к разбору", album_path(album), class: "btn-primary" %>
  </div>
</div>
