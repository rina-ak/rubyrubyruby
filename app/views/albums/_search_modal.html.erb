<div class="search-modal" id="search-modal" hidden>
  <button type="button" class="search-modal-backdrop" data-search-close aria-label="Закрыть"></button>
  <div class="search-modal-card" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
    <button type="button" class="search-modal-close" data-search-close aria-label="Закрыть">×</button>
    <h2 id="search-modal-title" class="search-modal-title">Поиск</h2>
    <%= form_with url: search_albums_path, method: :get, class: "search-modal-form", data: { turbo_frame: "search_results" } do %>
      <label class="search-modal-field">
        <span class="visually-hidden">Найти альбом или исполнителя</span>
        <%= search_field_tag :q, params[:q], placeholder: "Найти альбом или исполнителя", autocomplete: "off", data: { search_input: true } %>
      </label>
    <% end %>
    <%= turbo_frame_tag "search_results", class: "search-modal-results" do %>
      <p class="search-modal-hint">Введите название, исполнителя, жанр или год</p>
    <% end %>
  </div>
</div>
