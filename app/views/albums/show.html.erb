<header class="header">
  <div class="brand"><%= link_to "decode", root_path %></div>
  <nav class="nav">
    <%= link_to "Каталог", root_path %>
    <%= link_to "Подборки", collections_path %>
    <%= link_to "О проекте", about_path %>
    <%= link_to "Предложить альбом", new_album_proposal_path, class: "btn-header-cta" %>
  </nav>
</header>

<main class="container show-container">
  <div class="breadcrumbs">
    <%= link_to "каталог", root_path %> / <%= @album.artist %> / <%= @album.title %>
  </div>

  <div class="album-hero">
    <div class="hero-cover">
      <% if @album.cover_url.present? %>
        <%= image_tag @album.cover_url, alt: @album.title %>
      <% end %>
    </div>

    <div class="hero-header">
      <div class="tag-label">разбор альбома</div>
      <h1 class="hero-title"><%= @album.title %></h1>
      <div class="hero-artist"><%= @album.artist %></div>

      <div class="hero-submeta">
        <%= @album.release_year %> | <%= @album.genre %> | <%= @album.duration %> | <%= @album.release_type %>
      </div>

      <div class="action-buttons">
        <button class="btn-outline" type="button">Сохранить</button>
        <button class="btn-outline" type="button">Поделиться</button>
        <%= link_to "Редактировать", edit_album_path(@album), class: "btn-link" %>
      </div>
    </div>
  </div>

  <section class="section-block">
    <h3>Об альбоме</h3>
    <p class="intro-description"><%= @album.intro_text %></p>
  </section>

  <% if @album.thematic_sections.any? %>
    <section class="section-block">
      <h3>Тематические разделы</h3>
      <div class="thematic-grid">
        <% @album.thematic_sections.each do |sec| %>
          <div class="thematic-card">
            <h4><%= sec.title %></h4>
            <p><%= sec.content %></p>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <div class="bottom-nav">
    <%= link_to "← Назад к каталогу", albums_path, class: "btn-secondary" %>
  </div>

<hr style="margin: 2rem 0; border: 0; border-top: 1px solid #333;">

<section class="comments-section">
  <h3>Комментарии (<%= @album.comments.count %>)</h3>

  <div class="comments-list" style="margin-bottom: 2rem;">
    <% if @album.comments.any? %>
      <% @album.comments.each do |comment| %>
        <div style="background: rgba(255,255,255,0.05); padding: 0.8rem 1rem; border-radius: 6px; margin-bottom: 0.6rem;">
          <p style="margin: 0;"><%= comment.body %></p>
          <small style="opacity: 0.6;">
  <strong><%= comment.user&.email || "Гость" %></strong> • <%= comment.created_at.strftime("%d.%m.%Y %H:%M") %>
</small>
        </div>
      <% end %>
    <% else %>
      <p style="opacity: 0.6;">Комментариев пока нет. Будьте первыми!</p>
    <% end %>
  </div>

  <h4>Оставить комментарий</h4>
  <%= form_with(model: [ @album, @album.comments.build ], local: true) do |f| %>
    <div style="margin-bottom: 1rem;">
      <%= f.text_area :body, rows: 3, placeholder: "Напишите ваши мысли об альбоме...", style: "width: 100%; max-width: 600px; padding: 0.5rem; border-radius: 4px;" %>
    </div>
    <div>
      <%= f.submit "Отправить комментарий" %>
    </div>
  <% end %>
</section>

</main>
